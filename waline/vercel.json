{
  "name": "lewis-waline-comments",
  "github": {
    "silent": true
  },
  "env": {
    "NODE_OPTIONS": "--experimental-require-module",
    "SITE_NAME": "Lewis 的知识库",
    "SITE_URL": "https://lewislau86.github.io",
    "SECURE_DOMAINS": "lewislau86.github.io",
    "COMMENT_AUDIT": "true",
    "IPQPS": "60"
  },
  "builds": [
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "index.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/@mathjax/mathjax-newcm-font/**/*",
          "node_modules/mhchemparser/**/*",
          "node_modules/ip2region/data/**"
        ]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/((?!robots\\.txt$).*)",
      "destination": "index.cjs"
    }
  ]
}
